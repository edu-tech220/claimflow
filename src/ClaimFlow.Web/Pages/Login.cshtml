@page
@model ClaimFlow.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-4">Log in to ClaimFlow</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Log in</button>
        </form>

        <hr />
        <p class="text-muted small">
            Demo admin account: <code>admin@claimflow.dev</code> / <code>Admin#12345</code><br />
            Demo adjuster account: <code>adjuster@claimflow.dev</code> / <code>Adjuster#12345</code><br />
            Demo supervisor account: <code>supervisor@claimflow.dev</code> / <code>Supervisor#12345</code>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
