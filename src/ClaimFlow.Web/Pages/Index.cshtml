@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">ClaimFlow</h1>
    <p class="lead">Insurance claims intake, adjudication and approval tracking.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary btn-lg" asp-page="/Dashboard">Go to dashboard</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg" asp-page="/Login">Log in</a>
    }
</div>
