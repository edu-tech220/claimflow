@page
@model ClaimFlow.Web.Pages.Claims.NewModel
@{
    ViewData["Title"] = "File a claim";
}

<h1>File a new claim</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Input.PolicyNumber" class="form-label"></label>
        <input asp-for="Input.PolicyNumber" class="form-control" placeholder="e.g. POL-AUTO-0001" />
        <span asp-validation-for="Input.PolicyNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.IncidentDate" class="form-label"></label>
        <input asp-for="Input.IncidentDate" type="date" class="form-control" />
        <span asp-validation-for="Input.IncidentDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ClaimedAmount" class="form-label"></label>
        <input asp-for="Input.ClaimedAmount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Input.ClaimedAmount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit claim</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
